# ---- X data provider -------------------------------------------------------
# twitterapi.io is the default and the only fully implemented provider.
# Get a key at https://twitterapi.io — new keys come with ~$1 trial credit,
# which is enough to ingest ~6,000 posts.
X_API_KEY=your_twitterapi_io_key_here

# Provider selector. "twitterapi_io" (default) | "apidance" | "socialdata"
# The alternates are stubs that raise NotImplementedError naming what to add.
X_PROVIDER=twitterapi_io

# Optional: override the provider base URL (self-hosted proxy, testing).
# X_BASE_URL=https://api.twitterapi.io

# Optional: seconds between provider requests. Defaults to 5, because the
# free tier's MEASURED limit is one request every 5 seconds (a documented-
# nowhere fact learned from a live 429). Lower it on a paid tier; 0 disables.
# X_MIN_REQUEST_INTERVAL=5

# ---- Synthesis and search ----------------------------------------------------
# Used by the anthropic SDK for the map (claude-haiku-4-5) and reduce
# (claude-opus-5) passes — and for phase-2 search, which runs through the same
# key via the server-side web_search tool. One key, no second vendor.
ANTHROPIC_API_KEY=your_anthropic_key_here

# Search provider selector. "anthropic_search" (default) | "exa" | "brave"
# The alternates are stubs that raise NotImplementedError naming the env var
# and endpoint to add. Search costs $10 per 1,000 queries on top of tokens;
# `corpus run --no-search` turns the phase off entirely.
SEARCH_PROVIDER=anthropic_search

# ---- Paths -----------------------------------------------------------------
# SQLite content cache. Defaults to ~/.corpus/cache.db
# CORPUS_CACHE_DB=~/.corpus/cache.db
