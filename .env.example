# ---- X data provider -------------------------------------------------------
# twitterapi.io is the default and the only fully implemented provider.
# Get a key at https://twitterapi.io — new keys come with ~$1 trial credit,
# which is enough to ingest ~6,000 posts.
X_API_KEY=your_twitterapi_io_key_here

# Provider selector. "twitterapi_io" (default) | "apidance" | "socialdata"
# The alternates are stubs that raise NotImplementedError naming what to add.
X_PROVIDER=twitterapi_io

# Optional: override the provider base URL (self-hosted proxy, testing).
# X_BASE_URL=https://api.twitterapi.io

# ---- Synthesis -------------------------------------------------------------
# Used by the anthropic SDK for the map (claude-sonnet-5) and reduce
# (claude-opus-5) passes.
ANTHROPIC_API_KEY=your_anthropic_key_here

# ---- Paths -----------------------------------------------------------------
# SQLite content cache. Defaults to ~/.corpus/cache.db
# CORPUS_CACHE_DB=~/.corpus/cache.db
