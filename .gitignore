# runtime output — regenerate with `corpus run`
out/

# raw wire captures (`--capture-raw`). Real post content and real ids; the
# scrubbed subset that belongs in the repo lives in tests/fixtures/.
captures/

# GitHub API captures, same rule. Pulled by hand with a token because this
# sandbox's proxy refuses api.github.com; scrubbed into tests/fixtures/ by
# tests/fixtures/_scrub_github.py and then deleted. They hold a real person's
# identifiers and other people's prose, so they do not belong in the repo.
gh_captures/

# secrets
.env

